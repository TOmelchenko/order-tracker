{
  "title": "Order Tracker",
  "uid": "order-tracker-requests",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests by route and status code",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route, http_status_code) (rate(app_http_server_requests_total[1m]))",
          "legendFormat": "{{http_route}} [{{http_status_code}}]"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total requests by route and status code",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route, http_status_code) (app_http_server_requests_total)",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
